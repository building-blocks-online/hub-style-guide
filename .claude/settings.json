{
  "env": {
    "ORBIT_SWITCHBOARD_AS": "hub-style"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/switchboard-check.mjs\"",
            "timeout": 20
          }
        ]
      }
    ]
  }
}
